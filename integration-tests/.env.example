# OCI Skills Integration Test Configuration
# Copy this file to .env and fill in your values

# Registry URL (base only, script appends /test-skills:timestamp)
# Examples: ghcr.io/myorg, registry.example.com/namespace
# Do NOT include protocol (oci:// or https://)
OCI_REGISTRY_URL=ghcr.io/your-org

# Alternative environment variable name (same value)
# OCI_REPOSITORY_URL=ghcr.io/your-org

# Registry credentials
# For GitHub Container Registry (ghcr.io):
#   - Username: your GitHub username
#   - Password: GitHub Personal Access Token with packages:write scope
OCI_USERNAME=your-username
OCI_PASSWORD=your-token-or-password

# Notes:
# - These credentials will be passed to the CLI via --username and --password flags
# - They override any Docker config authentication
# - The test script will create timestamped artifact names like:
#   ghcr.io/your-org/test-skills:20251223143700
